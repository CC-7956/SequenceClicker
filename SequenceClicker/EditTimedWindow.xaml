<Window x:Class="SequenceClicker.EditTimedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SequenceClicker"
        mc:Ignorable="d"
        x:Name="EditTimedWin"
        Topmost="True"
        Title="EditTimedWindow" Height="400" Width="450">
    <Viewbox>
        <Grid Height="400" Width="450">
            <Button x:Name="btn_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Width="50" Focusable="False" Content="Click" Click="btn_AddClick"/>
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,7,0,0" Focusable="False" ToolTip="If >1 fill in the Delay values" Content="Click repeats:"/>
            <TextBox x:Name="TB_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="155,11,0,0" Width="50" ToolTip="Must be >0" PreviewTextInput="Pos" TextChanged="Update"/>
            <ToggleButton x:Name="Tog_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="210,11,0,0" Height="22" Width="22" Focusable="False">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Rectangle Stroke="Gray" StrokeThickness="1" Fill="{TemplateBinding Background}"/>
                            <TextBlock x:Name="TXT" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,2" FontSize="20"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="Khaki"/>
                                <Setter Property="ToolTip" Value="Rightclick"/>
                                <Setter TargetName="TXT" Property="Text" Value="R"/>
                                <Setter TargetName="TXT" Property="Foreground" Value="#8C96F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="CornflowerBlue"/>
                                <Setter Property="ToolTip" Value="Leftclick"/>
                                <Setter TargetName="TXT" Property="Text" Value="L"/>
                                <Setter TargetName="TXT" Property="Foreground" Value="#EDBC64"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Button x:Name="btn_Delay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" Width="50" IsEnabled="False" Focusable="False" Content="Delay" Click="btn_AddDelay"/>
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,37,0,0" Focusable="False" ToolTip="Can not be less then 1ms" Content="Min:"/>
            <TextBox x:Name="tb_dmin" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="95,41,0,0" Width="50" PreviewTextInput="PosDeci" TextChanged="Update"/>
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,37,0,0" Focusable="False" ToolTip="Can not be less then 1ms" Content="Sec:"/>
            <TextBox x:Name="tb_dsec" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="185,41,0,0" Width="50" PreviewTextInput="PosDeci" TextChanged="Update"/>

            <Button x:Name="btn_Move" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0" Width="50" IsEnabled="False" Focusable="False" Content="Move" Click="btn_AddMove"/>
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,67,0,0" Focusable="False" ToolTip="Try to stay inbounds" Content="X:"/>
            <TextBox x:Name="TB_X" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,71,0,0" Width="50" PreviewTextInput="PosNeg" TextChanged="Update"/>
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="135,67,0,0" Focusable="False" ToolTip="Try to stay inbounds" Content="Y:" />
            <TextBox x:Name="TB_Y" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="155,71,0,0" Width="50" PreviewTextInput="PosNeg" TextChanged="Update"/>

            <Button x:Name="btn_Test" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,100,0,0" Width="50" IsEnabled="False" Focusable="False" Content="Test" Click="btn_Test_Click"/>
            <Button x:Name="btn_Auto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,100,0,0" Width="50" Focusable="False" Content="Auto" Click="btn_Auto_Click"/>

            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,127,0,0" Width="50" Focusable="False" Content="Time" />
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60,127,0,0" Focusable="False" ToolTip="Can not be less then 1ms" Content="Min:" />
            <TextBox x:Name="tb_min" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="95,131,0,0" Width="50" PreviewTextInput="PosDeci" TextChanged="Update" />
            <Label HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,127,0,0" Focusable="False" ToolTip="Can not be less then 1ms" Content="Sec:" />
            <TextBox x:Name="tb_sec" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="185,131,0,0" Width="50" PreviewTextInput="PosDeci" TextChanged="Update" />
            
            <Button x:Name="btn_Delete" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,20" Width="50" Focusable="False" IsEnabled="False" Content="Delete" Click="btn_Delete_Click"/>
            <Button x:Name="btn_Reset" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,50" Width="50" Focusable="False" Content="Reset" Click="btn_Reset_Click"/>
            <Button x:Name="btn_Ok" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,180,80" Width="50" Focusable="False" IsEnabled="False" Content="Apply" Click="btn_Ok_Click"/>
            <TextBlock x:Name="Status" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10" Height="75" Width="200" Focusable="False" TextWrapping="Wrap" Text="Status"/>
            <ListView x:Name="LB_Seq" HorizontalAlignment="Right" VerticalAlignment="Top" Height="380" Margin="0,10,10,0" ToolTip="Drag and Drop to change order" Width="150" Focusable="False" SelectionMode="Single" 
                  ItemsSource="{Binding sequence}"
                  AllowDrop="True"
                  SelectionChanged="LB_Seq_SelectionChanged" 
                  PreviewMouseLeftButtonDown="LB_Seq_PreviewMouseLeftButtonDown" 
                  MouseMove="LB_Seq_MouseMove" 
                  DragOver="LB_Seq_DragOver"
                  Drop="LB_Seq_Drop">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <EventSetter Event="MouseDoubleClick" Handler="LB_Seq_MouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            
        </Grid>
    </Viewbox>
</Window>
