<Window x:Class="SequenceClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SequenceClicker"
        mc:Ignorable="d"
        x:Name="AutoClicker"
        Title="Super Cooler Sequenzen Clicker">
    <Viewbox>
        <Grid>
            <StackPanel Orientation="Horizontal" Margin="2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <!-- Click -->
                            <GroupBox Header="Click Task" MinHeight="150" MinWidth="150" Margin="10,10,0,0" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Clicks:" Margin="2"/>
                                        <TextBox x:Name="TB_Click" Margin="2" PreviewTextInput="Pos" TextChanged="Update"/>
                                    </StackPanel>
                                    <StackPanel x:Name="Stack_Delay" Orientation="Horizontal" Margin="2" Visibility="Collapsed">
                                        <Label Content="Delay:" Margin="2"/>
                                        <TextBox x:Name="TB_Click_Delay" Margin="2" PreviewTextInput="Pos" TextChanged="Update"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <ToggleButton x:Name="Tog_Click" Style="{StaticResource ClickToggle}" Width="30" Margin="2"/>
                                        <Image x:Name="imgLeft" Source=""></Image>
                                        <Image x:Name="imgRight" Source=""></Image>
                                    </StackPanel>
                                    <Button x:Name="btn_Click" Content="Add Click" Margin="2" Click="btn_AddClick"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Delay -->
                            <GroupBox Header="Delay Task" Margin="10,0,0,0" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Min:" Margin="2"/>
                                        <TextBox x:Name="tb_dmin" Margin="2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Sec:" Margin="2"/>
                                        <TextBox x:Name="tb_dsec" Margin="2"/>
                                    </StackPanel>
                                    <Button x:Name="btn_Delay" Content="Add Delay" Margin="2" HorizontalAlignment="Right" Click="btn_AddClick"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel>
                            <!-- Move -->
                            <GroupBox Header="Move Task" Margin="10,0,0,0" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="X:" Margin="2"/>
                                        <TextBox x:Name="TB_X" Margin="2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Y:" Margin="2"/>
                                        <TextBox x:Name="TB_Y" Margin="2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Button x:Name="btn_Test" Margin="2" Content="Test" Click="btn_Test_Click"/>
                                        <Button x:Name="btn_Auto" Margin="2" Content="Auto" Click="btn_Auto_Click"/>
                                    </StackPanel>
                                    <Button x:Name="btn_Move" Margin="2" Content="Add Move" Click="btn_AddMove"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Timed -->
                            <GroupBox Header="Timed Task" Margin="10,0,0,0" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Min:" Margin="2"/>
                                        <TextBox x:Name="tb_min" Margin="2"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Label Content="Sec:" Margin="2"/>
                                        <TextBox x:Name="tb_sec" Margin="2"/>
                                    </StackPanel>
                                    <Button x:Name="btn_Timed" Margin="2" Content="Time" Click="btn_AddTimed"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        
                    <!-- Control -->
                    <GroupBox Header="Control" Margin="10,0,0,0" Padding="10">
                        <StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Label ToolTip="Can not be negative" Content="Total repeats:" Margin="2"/>
                                    <TextBox x:Name="TB_Repeats" Width="50" Margin="2" ToolTip="Must be >0" PreviewTextInput="Pos" TextChanged="Update"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <ToggleButton x:Name="Tog_Inf" Style="{StaticResource Infinite}" Width="25" Margin="2" Click="Tog_Inf_Checked" ToolTip="Infinite repeats?"/>
                                    <Button x:Name="btn_Start" Margin="2" Content="Run x times" Click="btn_Start_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Button x:Name="btn_Delete" Margin="2" Content="Delete" Click="btn_Delete_Click"/>
                                <Button x:Name="btn_Reset" Margin="2" Content="Reset" Click="btn_Reset_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Button x:Name="btn_Save" Margin="2" Content="Save" Click="btn_Save_Click"/>
                                <Button x:Name="btn_Load" Margin="2" Content="Load" Click="btn_Load_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                        <Label Content="STRG + F6: Start autoclicker&#xA;STRG + F7: Cancel autoclicker&#xA;ALT + F7: Exit Application" FontSize="10" Margin="10,0,0,0"/>
                        <TextBlock x:Name="Status" TextWrapping="Wrap" Text="Status" FontSize="10" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                    
                <ListView x:Name="LB_Seq" HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="100" MaxHeight="750" Margin="0,10,10,0" ToolTip="Drag and Drop to change order" Width="150" Focusable="False" SelectionMode="Single" 
                    ItemsSource="{Binding sequence}"
                    AllowDrop="True"
                    SelectionChanged="LB_Seq_SelectionChanged" 
                    PreviewMouseLeftButtonDown="LB_Seq_PreviewMouseLeftButtonDown" 
                    MouseMove="LB_Seq_MouseMove" 
                    DragOver="LB_Seq_DragOver"
                    Drop="LB_Seq_Drop">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="LB_Seq_MouseDoubleClick"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                
            </StackPanel>
            
        </Grid>
    </Viewbox>
</Window>
